genrule(
    name = "web_build",
    srcs = ["tools/build-web.sh"],
    outs = ["build-web"],
    cmd = "cp $(location tools/build-web.sh) $@ && chmod +x $@",
    executable = True,
    visibility = ["//visibility:public"],
)

genrule(
    name = "dev",
    srcs = ["tools/dev.sh"],
    outs = ["dev-server"],
    cmd = "cp $(location tools/dev.sh) $@ && chmod +x $@",
    executable = True,
    visibility = ["//visibility:public"],
)
