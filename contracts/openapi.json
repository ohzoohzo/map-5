{
  "openapi": "3.1.0",
  "info": {
    "title": "5조 여행 설계 API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Get Config",
        "operationId": "get_config",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/docent/status": {
      "get": {
        "tags": [
          "docent"
        ],
        "summary": "Docent Status",
        "operationId": "docent_status",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureStatus"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/docent/story": {
      "get": {
        "tags": [
          "docent"
        ],
        "summary": "Docent Story",
        "operationId": "docent_story",
        "parameters": [
          {
            "name": "place_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "title": "Place Id"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "title": "Name"
            }
          },
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 39.0,
              "minimum": 33.0,
              "title": "Latitude"
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 132.0,
              "minimum": 124.0,
              "title": "Longitude"
            }
          },
          {
            "name": "address",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "default": "",
              "title": "Address"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocentStory"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        }
      }
    },
    "/api/taste/status": {
      "get": {
        "tags": [
          "taste"
        ],
        "summary": "Taste Status",
        "operationId": "taste_status",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureStatus"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/travel/catalog": {
      "get": {
        "tags": [
          "travel"
        ],
        "summary": "Get Catalog",
        "operationId": "get_catalog",
        "parameters": [
          {
            "name": "region",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 80,
              "default": "",
              "title": "Region"
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "default": "",
              "title": "Query"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/travel/search": {
      "get": {
        "tags": [
          "travel"
        ],
        "summary": "Search Places",
        "operationId": "search_places",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "title": "Query"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        }
      }
    },
    "/api/weather/status": {
      "get": {
        "tags": [
          "weather"
        ],
        "summary": "Weather Status",
        "operationId": "weather_status",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureStatus"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogResponse": {
        "properties": {
          "places": {
            "items": {
              "$ref": "#/components/schemas/Place"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Places"
          },
          "total": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 0.0,
            "title": "Total"
          },
          "regions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Regions"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "date_min": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Min"
          },
          "date_max": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Max"
          },
          "total_catalog": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Catalog"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "places",
          "total",
          "regions",
          "source",
          "source_url",
          "date_min",
          "date_max",
          "total_catalog"
        ],
        "title": "CatalogResponse"
      },
      "ConfigResponse": {
        "properties": {
          "js_key": {
            "type": "string",
            "title": "Js Key"
          },
          "place_search_enabled": {
            "type": "boolean",
            "title": "Place Search Enabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "js_key",
          "place_search_enabled"
        ],
        "title": "ConfigResponse"
      },
      "DocentReference": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "kind": {
            "type": "string",
            "enum": [
              "catalog",
              "tour",
              "heritage"
            ],
            "title": "Kind"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index",
          "kind",
          "label",
          "source",
          "url",
          "date"
        ],
        "title": "DocentReference",
        "description": "해설의 근거 원문. 번호(index)로 섹션과 연결된다."
      },
      "DocentSection": {
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "history",
              "feature",
              "tip"
            ],
            "title": "Key"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "reference_indexes": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Reference Indexes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "title",
          "body",
          "reference_indexes"
        ],
        "title": "DocentSection"
      },
      "DocentStory": {
        "properties": {
          "place_id": {
            "type": "string",
            "title": "Place Id"
          },
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/DocentSection"
            },
            "type": "array",
            "title": "Sections"
          },
          "references": {
            "items": {
              "$ref": "#/components/schemas/DocentReference"
            },
            "type": "array",
            "title": "References"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "generated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "place_id",
          "ready",
          "message",
          "summary",
          "sections",
          "references",
          "model",
          "generated_at"
        ],
        "title": "DocentStory"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "FeatureStatus": {
        "properties": {
          "feature": {
            "type": "string",
            "title": "Feature"
          },
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feature",
          "ready",
          "message"
        ],
        "title": "FeatureStatus",
        "description": "기능 라우터의 연동 상태. 실제 데이터가 없을 때 가짜 값 대신 이 응답으로 상태를 알린다."
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "Place": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "address": {
            "type": "string",
            "title": "Address"
          },
          "latitude": {
            "type": "number",
            "maximum": 39.0,
            "minimum": 33.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 132.0,
            "minimum": 124.0,
            "title": "Longitude"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "title": "Source"
          },
          "source_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Date"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "address",
          "latitude",
          "longitude",
          "category",
          "description",
          "phone",
          "source",
          "source_date",
          "url"
        ],
        "title": "Place"
      },
      "SearchResponse": {
        "properties": {
          "places": {
            "items": {
              "$ref": "#/components/schemas/Place"
            },
            "type": "array",
            "maxItems": 15,
            "title": "Places"
          },
          "total": {
            "type": "integer",
            "maximum": 15.0,
            "minimum": 0.0,
            "title": "Total"
          },
          "source": {
            "type": "string",
            "const": "카카오 로컬 API",
            "title": "Source"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "date_min": {
            "type": "null",
            "title": "Date Min"
          },
          "date_max": {
            "type": "null",
            "title": "Date Max"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "places",
          "total",
          "source",
          "source_url",
          "date_min",
          "date_max"
        ],
        "title": "SearchResponse"
      }
    }
  }
}
