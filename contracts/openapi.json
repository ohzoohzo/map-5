        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "published_date": {
            "type": "string",
            "title": "Published Date"
          },
          "source_name": {
            "type": "string",
            "title": "Source Name"
          },
          "url": {
            "type": "string",
            "title": "Url"
