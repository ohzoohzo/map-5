  "components": {
    "schemas": {
      "CatalogResponse": {
        "properties": {
          "places": {
            "items": {
              "$ref": "#/components/schemas/Place"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Places"
          },
          "total": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 0.0,
            "title": "Total"
          },
          "regions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Regions"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "date_min": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Min"
          },
          "date_max": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Max"
          },
          "total_catalog": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Catalog"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "places",
          "total",
          "regions",
          "source",
          "source_url",
          "date_min",
          "date_max",
          "total_catalog"
        ],
        "title": "CatalogResponse"
      },
      "ConfigResponse": {
        "properties": {
          "js_key": {
            "type": "string",
            "title": "Js Key"
          },
          "place_search_enabled": {
            "type": "boolean",
            "title": "Place Search Enabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "js_key",
          "place_search_enabled"
        ],
        "title": "ConfigResponse"
      },
      "DocentNews": {
        "properties": {
          "place_id": {
            "type": "string",
            "title": "Place Id"
          },
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/DocentNewsItem"
            },
            "type": "array",
            "title": "Items"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "searched_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Searched At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "place_id",
          "ready",
          "message",
          "items",
          "model",
          "searched_at"
        ],
        "title": "DocentNews"
      },
